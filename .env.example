# Copy to .env and fill in. NEVER commit .env.
#
# Absent credentials are not an error: every live path degrades to a typed
# AUTHENTICATION_REQUIRED result and `make live-smoke` skips cleanly.

# --- Execution safety. Leave both at these values during groundwork. ---------
TRADEUP_LIVE_EXECUTION_ENABLED=false
TRADEUP_MAX_DAILY_SPEND_MINOR=0

# --- Persistence -------------------------------------------------------------
TRADEUP_DATABASE_URL=sqlite+pysqlite:///./tradeup.db

# --- Read-only market credentials (optional) ---------------------------------
TRADEUP_CSFLOAT_API_KEY=
TRADEUP_DMARKET_PUBLIC_KEY=
TRADEUP_DMARKET_SECRET_KEY=
TRADEUP_SKINSNIPE_API_KEY=

# --- Operator notification (optional) ----------------------------------------
TRADEUP_TELEGRAM_BOT_TOKEN=

# --- Crypto settlement rail (optional) ----------------------------------------
# Enable only when venue balances are funded from, and proceeds withdrawn to, the
# operator's own crypto wallet. When enabled, SETTLEMENT_CURRENCY must be a crypto
# currency (BTC, ETH or USDT) and every contract is charged an amortised share of
# the modelled deposit/withdrawal round trip. The wallet address appears only in
# operator instructions and is never logged. Haircut and amortisation are stated
# priors pending calibration. Not needed for read-only scanning.
TRADEUP_CRYPTO_SETTLEMENT_ENABLED=false
TRADEUP_SETTLEMENT_CURRENCY=USD
TRADEUP_CRYPTO_WALLET_ADDRESS=
TRADEUP_MAX_CONVERSION_QUOTE_AGE_SECONDS=120
TRADEUP_CRYPTO_VOLATILITY_HAIRCUT=0.02
TRADEUP_SETTLEMENT_AMORTIZATION_CONTRACTS=10

# --- Profitability + risk gates (Decimal strings / integers) -----------------
TRADEUP_DISCOVERY_MIN_NET_ROI=0.12
TRADEUP_FINAL_MIN_NET_ROI=0.08
TRADEUP_MIN_ABSOLUTE_EXPECTED_PROFIT_MINOR=300
TRADEUP_MAX_CONTRACT_COST_MINOR=50000
TRADEUP_MAX_WORST_CASE_LOSS_MINOR=40000
TRADEUP_MAX_PARTIAL_FILL_EXPOSURE_MINOR=15000
TRADEUP_MAX_QUOTE_AGE_SECONDS=300
TRADEUP_MAX_EXPECTED_CAPITAL_DAYS=21
